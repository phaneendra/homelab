# Paths (adjust to your host storage)
DOCKER_USER_DATA=/home/homelab
DOCKER_VOLUME_STORAGE=/mnt/shared-storage

# Database
FORGEJO_DB_NAME=forgejo
FORGEJO_DB_USER=forgejo
# IMPORTANT: replace with a strong password and do NOT commit to VCS
FORGEJO_DB_PASSWORD=change-me-set-a-strong-password

# Ports
FORGEJO_HTTP_PORT=3000
FORGEJO_SSH_PORT=2222

# Public URL / domain
FORGEJO_DOMAIN=forgejo.localhost
FORGEJO_ROOT_URL=http://${FORGEJO_DOMAIN}:${FORGEJO_HTTP_PORT}

# Security
# IMPORTANT: replace with a securely-generated secret (example: `openssl rand -hex 32`)
FORGEJO_SECRET_KEY=replace-with-secure-random
FORGEJO_INSTALL_LOCK=false

# Misc
TZ=UTC
