# Example environment variables for AFFiNE deployment
# Set DOCKER_VOLUME_STORAGE to your shared storage base path
DOCKER_VOLUME_STORAGE=/mnt/shared-storage

# Domain for AFFiNE (used by traefik labels). Override to your domain, e.g. affine.phanee.in
AFFINE_DOMAIN=affine.phanee.in

# Shared Postgres credentials (must match shared_postgres init/config)
POSTGRES_PASSWORD=change_me_secure_password
POSTGRES_USER=affine
POSTGRES_DB=affine

# Optional: override compose behavior or add runtime secrets here
# Ensure the shared storage path exists and is writable by the container user
# mkdir -p /mnt/shared-storage/data/affine/storage && chown -R 1000:1000 /mnt/shared-storage/data/affine/storage
