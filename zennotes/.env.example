# Example environment for Zennotes
DOCKER_USER_DATA=/home/phaneendra
# Shared storage base (used for vault and server data)
DOCKER_VOLUME_STORAGE=/mnt/shared-storage

# Domain exposed via Traefik (used in docker-compose labels)
ZENN_DOMAIN=zennotes.phanee.in

# Authentication token (required). Generate with: openssl rand -hex 32
ZENNOTES_AUTH_TOKEN=change_me_to_a_secure_token

# Optional: comma-separated CIDR for trusted proxies (if behind reverse proxy)
ZENNOTES_TRUSTED_PROXIES=127.0.0.1/32

# Host preparation notes:
# mkdir -p /mnt/shared-storage/data/zennotes/vault /mnt/shared-storage/data/zennotes/data
# chown -R 65532:65532 /mnt/shared-storage/data/zennotes
# The image runs as uid 65532 by default; ensure the mounted dirs are writable by that UID.
